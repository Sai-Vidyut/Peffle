# Peffle AI providers — configure once for the CLI (works from any directory):
#   mkdir -p ~/.config/peffle && cp .env.example ~/.config/peffle/.env
# Optional project overrides (current directory only): .env then .env.local
# Shell exports always take precedence over files.

PEFFLE_AI_PROVIDER=auto
GEMINI_API_KEY=
GROQ_API_KEY=
# PEFFLE_AI_MODEL=gemini-3.8-flash
# PEFFLE_GROQ_MODEL=openai/gpt-oss-20b
# PEFFLE_CONFIG_DIR=  # override user config directory (advanced / tests)
