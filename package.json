{
  "name": "peffle",
  "version": "0.1.6",
  "description": "Stop an AI agent before it spends your money — local kill switch, spend caps, and approval gates for tool calls",
  "license": "Apache-2.0",
  "author": "Sai Vidyut",
  "homepage": "https://github.com/Sai-Vidyut/Peffle#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sai-Vidyut/Peffle.git"
  },
  "bugs": {
    "url": "https://github.com/Sai-Vidyut/Peffle/issues"
  },
  "keywords": [
    "ai-agent",
    "mcp",
    "llm",
    "kill-switch",
    "budget",
    "policy",
    "approval",
    "guardrails",
    "audit"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.cjs"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js",
      "require": "./dist/mcp/index.cjs"
    }
  },
  "bin": {
    "peffle": "dist/cli/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "verify:dist": "node scripts/verify-dist.mjs",
    "prepublishOnly": "npm run build && npm run verify:dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "example": "tsx examples/blocked-spend.ts",
    "demo": "tsx examples/mcp-email-agent/client.ts",
    "pulse": "node scripts/pulse.mjs"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "boxen": "^8.0.1",
    "chalk": "^5.4.1",
    "commander": "^12.1.0",
    "wrap-ansi": "^9.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.10",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "tsx": "^4.19.3",
    "vitest": "^3.0.9"
  },
  "engines": {
    "node": ">=18"
  }
}
